{
  "name": "@mpeep/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens": "./src/tokens.ts",
    "./utils": "./src/utils.ts",
    "./button-variants": "./src/button-variants.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "dev": "pnpm docs:generate && next dev -p 3005",
    "build": "pnpm docs:generate && next build",
    "start": "next start -p 3005",
    "docs:generate": "node scripts/generate-props.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.tsx",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "1.28.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "^10.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
